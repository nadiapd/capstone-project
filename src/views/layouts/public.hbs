<!DOCTYPE html>
<html lang="id">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Track - TechService</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <script src="/js/validator.js"></script>
  <style>
    @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap');

    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      background-color: #0f172b;
    }
  </style>
</head>

<body>
  <div id="global-alerts" class="absolute top-8 right-0 md:right-10 z-[999] min-w-[300px] px-4">
    {{#if errors}}
    <div id="errors-container"
      class="mb-4 flex items-start p-4 bg-red-600 rounded-xl border border-red-500 shadow-2xl shadow-red-500/40 animate-fade-in">
      <div class="flex-shrink-0 bg-red-700/50 rounded-lg p-1.5 mr-3 mt-0.5">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
            d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z">
          </path>
        </svg>
      </div>
      <div class="flex-1">
        <p class="text-sm font-black text-white uppercase tracking-tight mb-1">Terjadi Kesalahan</p>
        <ul class="list-disc list-inside">
          {{#each errors}}
          {{#each this}}
          <li class="text-[11px] text-red-100 font-bold leading-relaxed">{{this}}</li>
          {{/each}}
          {{/each}}
        </ul>
      </div>
      <button type="button" onclick="closeAlert('errors-container')"
        class="ml-auto text-red-200 hover:text-white transition-colors p-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    {{/if}}
    {{#if success}}
    <div id="success-container"
      class="mb-4 flex items-center p-4 bg-emerald-600 rounded-xl border border-emerald-500 shadow-2xl shadow-emerald-500/40 animate-fade-in">
      <div class="flex-shrink-0 bg-emerald-700/50 rounded-lg p-1.5 mr-3">
        <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
        </svg>
      </div>
      <div class="flex-1">
        <p class="text-sm font-black text-white uppercase tracking-tight">Berhasil</p>
        <p class="text-[11px] text-emerald-50 font-bold leading-relaxed">{{success}}</p>
      </div>
      <button type="button" onclick="closeAlert('success-container')"
        class="ml-auto text-emerald-200 hover:text-white transition-colors p-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path d="M6 18L18 6M6 6l12 12" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
    {{/if}}
  </div>
  <div class="min-h-screen flex flex-col items-center justify-center p-6">
    <div class="w-full max-w-2xl">
      <div class="flex flex-col items-center mb-8 gap-2">
        <div
          class="w-16 h-16 text-blue-600 bg-white rounded-xl flex items-center justify-center shadow-lg shadow-blue-900/50">
          <svg fill="currentColor" class="w-12 h-12" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg"
            xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 328.135 328.135" xml:space="preserve">
            <g id="SVGRepo_bgCarrier" stroke-width="0"></g>
            <g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g>
            <g id="SVGRepo_iconCarrier">
              <g>
                <g>
                  <path
                    d="M52.735,94.94l12.667,12.667L49.279,123.73c16.404,10.588,38.508,8.714,52.874-5.647L42.26,58.194 c-14.362,14.362-16.236,36.47-5.647,52.874L52.735,94.94z">
                  </path>
                  <polygon
                    points="144.419,45.911 147.327,35.681 124.922,13.276 114.693,16.184 68.295,62.582 98.022,92.309 ">
                  </polygon>
                  <path
                    d="M214.195,132.966l79.13-85.304c0.169-0.169,0.353-0.297,0.522-0.466l12.324-1.72l21.965-32.568L315.34,0.113 l-33.009,21.939l-1.28,12.349c-0.164,0.169-0.297,0.353-0.466,0.522l-85.304,79.135 C202.449,121.329,206.858,125.742,214.195,132.966z">
                  </path>
                  <path
                    d="M246.655,200.223l-37.35,37.35l13.67,51.021l51.021,13.67l37.35-37.35l-13.67-51.021L246.655,200.223z M276.423,267.336 c-8.888,8.888-23.301,8.888-32.189,0s-8.888-23.301,0-32.184c8.888-8.888,23.301-8.888,32.189,0 C285.311,244.035,285.311,258.447,276.423,267.336z">
                  </path>
                  <path
                    d="M204.39,145.761c-8.924-8.781-13.353-13.205-22.139-22.129c-6.323-6.421-16.65-6.589-23.127-0.317 c-0.333,0.323-0.671,0.65-1.004,0.973c6.246,6.446,6.205,16.727-0.164,23.096c-6.436,6.436-16.865,6.436-23.301,0 c-0.061-0.061-0.102-0.138-0.164-0.2C91.187,189.158,47.877,231.127,4.566,273.101c-6.472,6.272-6.021,17.249,1.075,24.453 c9.856,10.004,14.817,14.971,24.827,24.827c7.204,7.096,18.181,7.547,24.453,1.075c2.61-2.695,5.222-5.39,7.833-8.085 l-50.104-50.104c4.823-4.675,9.646-9.349,14.469-14.024l49.659,49.659c34.693-35.799,69.381-71.598,104.074-107.397 c-0.128-0.118-0.271-0.2-0.394-0.323c-6.436-6.436-6.436-16.865,0-23.301c6.431-6.431,16.86-6.431,23.291-0.005 c0.317-0.328,0.635-0.655,0.957-0.988C210.979,162.417,210.815,152.085,204.39,145.761z">
                  </path>
                  <path
                    d="M69.135,308.787c-2.126,2.195-4.253,4.389-6.38,6.584l0,0C64.88,313.175,67.01,310.984,69.135,308.787z">
                  </path>
                </g>
              </g>
            </g>
          </svg>
        </div>
        <h1 class="text-xl font-bold tracking-tight text-white">
          Tech<span class="text-blue-500">Service</span>
        </h1>
      </div>
    </div>
    <main class="w-full max-w-2xl relative">
      {{{body}}}
    </main>
  </div>
  <script src="/js/validator.js"></script>
</body>
<script>
  function closeAlert(id) {
    const alertBox = document.getElementById(id);
    if (alertBox) {
      alertBox.classList.add('opacity-0', 'scale-95', 'transition-all', 'duration-500');
      setTimeout(() => {
        alertBox.remove();
      }, 500);
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const successBox = document.getElementById('success-container');
    const errorBox = document.getElementById('errors-container');
    if (successBox) {
      setTimeout(() => {
        closeAlert('success-container');
      }, 5000);
    }
    if (errorBox) {
      setTimeout(() => {
        closeAlert('errors-container');
      }, 5000);
    }
    if (window.history.replaceState) {
      const url = new URL(window.location.href);
      if (url.searchParams.has('status') || url.searchParams.has('message')) {
        url.searchParams.delete('status');
        url.searchParams.delete('message');
        window.history.replaceState({ path: url.href }, '', url.href);
      }
    }

    const currentPath = window.location.pathname;
    const navLinks = document.querySelectorAll('#sidebar-nav a');

    navLinks.forEach(link => {
      link.classList.remove('nav-active');

      if (currentPath === link.getAttribute('href')) {
        link.classList.add('nav-active');
      }

      if (currentPath.startsWith('/services') && link.getAttribute('href') === '/services') {
        link.classList.add('nav-active');
      }
    });
  });
</script>

</html>