  <div class="w-full max-w-2xl mt-6">
    <div class="flex flex-col items-center mb-8 gap-2">
      <div
        class="w-16 h-16 text-blue-600 bg-white rounded-xl flex items-center justify-center shadow-lg shadow-blue-900/50">
        <svg fill="currentColor" class="w-12 h-12" version="1.1" id="Layer_1" xmlns="http://www.w3.org/2000/svg"
