<div class="max-w-3xl mx-auto bg-white rounded-2xl shadow p-8">

  <h1 class="text-3xl font-bold mb-6">
    Service Detail
  </h1>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="rounded-2xl bg-slate-50 p-6">
      <p class="text-slate-500 text-sm">Tracking Code</p>
      <p class="mt-2 font-semibold">{{service.tracking_code}}</p>
    </div>
    <div class="rounded-2xl bg-slate-50 p-6">
      <p class="text-slate-500 text-sm">Current Status</p>
      <p class="mt-2 font-semibold capitalize">{{service.status}}</p>
    </div>
    <div class="rounded-2xl bg-slate-50 p-6">
      <p class="text-slate-500 text-sm">Customer</p>
      <p class="mt-2 font-semibold">{{service.customer.name}}</p>
      <p class="text-slate-600 text-sm">{{service.customer.email}}</p>
      <p class="text-slate-600 text-sm">{{service.customer.phone}}</p>
    </div>
  </div>

  <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="rounded-2xl bg-slate-50 p-6">
      <p class="text-slate-500 text-sm">Device</p>
      <p class="mt-2 font-semibold">{{service.device_name}}</p>
      <p class="text-slate-600">{{service.device_brand}}</p>
      <p class="text-slate-600">Kategori: {{#if service.device_category_other}}{{service.device_category_other}}{{else}}{{service.device_category}}{{/if}}</p>
    </div>
    <div class="rounded-2xl bg-slate-50 p-6">
      <p class="text-slate-500 text-sm">note</p>
      <p class="mt-2 text-slate-600">{{service.note}}</p>
    </div>
  </div>

  <div class="mt-8 rounded-2xl bg-slate-50 p-6">
    <h2 class="text-xl font-semibold">Timeline Progress</h2>
    <div class="mt-4 space-y-4">
      {{#each service.histories}}
        <div class="rounded-2xl bg-white p-4 shadow-sm">
          <div class="flex items-center justify-between gap-4">
            <span class="font-semibold capitalize">{{status}}</span>
            <span class="text-sm text-slate-500">{{formatDate createdAt}}</span>
          </div>
          <p class="mt-3 text-slate-600">{{note}}</p>
          {{#if updated_by}}
            <p class="mt-2 text-xs text-slate-400">Updated by: {{updated_by}}</p>
          {{/if}}
        </div>
      {{else}}
        <p class="text-slate-600">Belum ada progress update.</p>
      {{/each}}
    </div>
  </div>

</div>