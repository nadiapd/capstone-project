          </g>
        </svg>
      </div>
      <h1 class="text-xl font-bold tracking-tight text-white">
        Tech<span class="text-blue-500">Service</span>
      </h1>
    </div>
  </div>
  <div class="w-full max-w-2xl mx-auto animate-fade-in">
    <div class="bg-white rounded-xl shadow-2xl shadow-slate-200/60 border border-slate-50 overflow-hidden">
      <div class="p-8 {{service.status_color}} text-center relative border-b border-black/5">
        <div class="absolute inset-0 bg-white/20"></div>
        <div class="relative z-10">
          <div class="flex items-center justify-center gap-2 mb-2">
            <p class="text-[10px] font-black uppercase tracking-[0.3em] opacity-60">
              Servis #<span id="trackingCode">{{service.tracking_code}}</span>
            </p>
            <button onclick="copyTrackingID()" class="p-1 hover:bg-black/5 rounded transition-colors active:scale-90"
              title="Salin ID">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 opacity-40" fill="none" viewBox="0 0 24 24"
                stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                  d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </button>
          </div>
          <h3 class="text-3xl font-extrabold uppercase tracking-tight">
            {{service.status_label}}
          </h3>
        </div>
      </div>
      <div class="p-6 md:p-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-8">
          <div class="flex flex-col gap-1 p-4 bg-slate-50 rounded-xl border border-slate-100">
            <span class="text-[10px] text-slate-400 font-black uppercase tracking-widest">Pemilik</span>
            <p class="text-slate-900 font-extrabold text-base">{{service.customer_name}}</p>
          </div>
          <div class="flex flex-col gap-1 p-4 bg-slate-50 rounded-xl border border-slate-100 sm:text-right">
            <span class="text-[10px] text-slate-400 font-black uppercase tracking-widest">Unit / Perangkat</span>
            <p class="text-slate-900 font-extrabold text-base">{{service.device_name}}</p>
          </div>
        </div>
        {{#if service.total_price}}
        <div
          class="mb-10 p-6 bg-slate-900 rounded-2xl shadow-xl shadow-blue-900/10 text-white relative overflow-hidden animate-fade-in">
          <div class="absolute top-0 right-0 w-32 h-32 bg-blue-600/20 rounded-full -mr-16 -mt-16 blur-2xl"></div>
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 relative z-10">
            <div>
              <p class="text-[10px] font-black text-blue-400 uppercase tracking-[0.2em] mb-1">Total Biaya Akhir</p>
              <p class="text-3xl font-black tracking-tight">{{formatCurrency service.total_price}}</p>
            </div>
            {{#if (eq service.status 3)}}
            <div class="flex items-center gap-2 px-4 py-2 bg-emerald-500/10 border border-emerald-500/20 rounded-xl">
              <span class="text-emerald-400 text-sm">✓</span>
              <p class="text-[10px] text-emerald-100 font-black uppercase tracking-wider">Siap Diambil</p>
            </div>
            {{/if}}
          </div>
        </div>
        {{/if}}
        <div class="space-y-8 relative">
          <h4
            class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em] flex items-center gap-2 mb-8 ml-1">
            <span class="w-1.5 h-1.5 bg-blue-600 rounded-full"></span> Riwayat Pengerjaan
          </h4>
          <div
            class="relative pl-8 space-y-10 before:content-[''] before:absolute before:left-[11px] before:top-2 before:bottom-2 before:w-[1.5px] before:bg-slate-100">
            {{#each history}}
            <div class="relative group">
              <div class="absolute -left-8 top-1 w-6 h-6 bg-white border-[3px] border-blue-600 rounded-full z-10"></div>
              <div class="flex flex-col gap-2">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase shadow-sm {{this.status_color}}">
                    {{this.status_label}}
                  </span>
                  <span class="text-[10px] font-bold text-slate-400">
                    {{formatDate this.created_at}}
                  </span>
                </div>
                <div
                  class="bg-slate-50 rounded-xl p-4 border border-slate-100 shadow-sm transition-colors group-hover:bg-blue-50/30">
                  <p class="text-[13px] text-slate-700 font-medium leading-relaxed">
                    {{this.note}}
                  </p>
                </div>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
      <div class="p-6 bg-slate-50 border-t border-slate-100 text-center">
        <p class="text-[9px] text-slate-400 font-medium mb-4 italic px-4 uppercase tracking-tighter">
          Halaman ini bersifat privat. Silakan hubungi admin jika butuh bantuan lebih lanjut.
        </p>
        <a href="/track"
          class="inline-flex items-center gap-2 px-8 py-3 bg-white border border-slate-200 rounded-xl text-[10px] font-black text-slate-600 uppercase tracking-widest hover:bg-slate-100 hover:text-blue-600 transition-all shadow-sm">
          ← Keluar & Lacak Baru
        </a>
      </div>
    </div>
  </div>
</div>
<script>
  function copyTrackingID() {
    const trackingText = document.getElementById('trackingCode').innerText;
    navigator.clipboard.writeText(trackingText).then(() => {
      const btn = event.currentTarget;
      const originalHTML = btn.innerHTML;
      btn.innerHTML = '<span class="text-[10px] opacity-60">✓</span>';
      setTimeout(() => {
        btn.innerHTML = originalHTML;
      }, 2000);
    })
  }
</script>