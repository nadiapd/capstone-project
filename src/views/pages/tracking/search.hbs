<div class="max-w-xl mx-auto bg-white p-8 rounded-2xl shadow">

  <h1 class="text-3xl font-bold mb-4">
    Tracking Service
  </h1>

  <p class="text-slate-500 mb-8">
    Masukkan tracking code dan nomor HP atau email untuk validasi.
  </p>

  {{#if error}}
    <div class="mb-4 rounded-2xl border border-red-200 bg-red-50 p-4 text-red-700">
      {{error}}
    </div>
  {{/if}}

  <form action="/tracking" method="GET">

    <input
      type="text"
      name="tracking_code"
      value="{{old.tracking_code}}"
      placeholder="Input tracking code"
      class="w-full border rounded-lg p-3 mb-4"
    />

    <input
      type="email"
      name="email"
      value="{{old.email}}"
      placeholder="Email customer"
      class="w-full border rounded-lg p-3 mb-4"
    />

    <input
      type="text"
      name="phone"
      value="{{old.phone}}"
      placeholder="No. HP customer"
      class="w-full border rounded-lg p-3 mb-4"
    />

    <button
      type="submit"
      class="w-full bg-slate-900 text-white p-3 rounded-lg"
    >
      Check Status
    </button>

  </form>

</div>