  <div class="max-w-2xl mx-auto">
    <div class="flex flex-col justify-center items-center text-center mb-10 animate-fade-in gap-1.5">
      <h2 class="text-white text-xl font-bold uppercase">Lacak Unit Anda</h2>
      <p class="text-white text-sm">Masukkan detail di bawah untuk melihat progres perbaikan.</p>
    </div>
    <div class="bg-white rounded-2xl p-8 md:p-10 shadow-2xl shadow-slate-200/60 border border-slate-50 animate-fade-in">
      <form action="/track" method="POST" id="track-form" class="space-y-6">
        <div>
          <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">Kode
            Tracking</label>
          <div class="flex gap-2 items-center group relative">
            <span
              class="top-4 absolute z-[1] pl-4 text-slate-400 font-bold group-focus-within:text-blue-600 transition-colors">#</span>
            <div class="w-full">
              <input ttype="text" name="tracking_code" fieldname="Kode Tracking" rules="required"
                placeholder="Contoh: 2026001"
                class="w-full pl-12 bg-white border border-slate-100 rounded-lg p-4 focus:ring-4 focus:ring-blue-50 focus:border-blue-600 outline-none transition-all disabled:pointer-events-none disabled:opacity-80">
            </div>
          </div>
        </div>
        <div>
          <label class="block text-[10px] font-black text-slate-400 uppercase tracking-widest mb-2 ml-1">Kontak</label>
          <div class="flex gap-2 items-center group relative">
            <span
              class="top-4 absolute z-[1] pl-4 text-slate-400 font-bold group-focus-within:text-blue-600 transition-colors">🔑</span>
            <div class="w-full">
              <input type="text" name="contact_verification" fieldname="Kontak" rules="required"
                placeholder="Email atau No. WhatsApp"
                class="w-full pl-12 bg-white border border-slate-100 rounded-lg p-4 focus:ring-4 focus:ring-blue-50 focus:border-blue-600 outline-none transition-all disabled:pointer-events-none disabled:opacity-80">
            </div>
          </div>
          <p class="text-[10px] text-slate-400 mt-3 italic font-medium">*Gunakan data yang Anda berikan saat pendaftaran
            unit.</p>
        </div>
        <button type="submit"
          class="w-full py-4 bg-blue-600 hover:bg-blue-700 text-white rounded-xl font-black text-sm shadow-xl shadow-blue-200 transition-all transform hover:-translate-y-1">
          LIHAT STATUS PROGRES →
        </button>
      </form>
    </div>
  </div>
</div>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    initLiveValidation('#track-form');
  });
</script>