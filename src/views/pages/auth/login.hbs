        </div>
      <h1 class="text-xl font-bold tracking-tight text-white">
          Tech<span class="text-blue-500">Service</span>
        </h1>
      <p class="text-slate-400 text-sm font-medium mt-1">Management Panel v1.0</p>
    </div>

    <div class="bg-white p-10 rounded-[2.5rem] shadow-xl shadow-slate-200/50 border border-slate-100">
      <div class="mb-8">
        <h2 class="text-xl font-bold text-slate-900">Selamat Datang</h2>
        <p class="text-slate-500 text-sm mt-1">Masuk untuk mengelola layanan Anda.</p>
      </div>
      {{#if message}}
      <div id="alert-error" class="mb-6 flex items-center p-4 bg-red-50 rounded-xl drop-shadow">
          <div class="flex-shrink-0 bg-red-100 rounded-lg p-1 mr-3">
              <svg class="w-4 h-4 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path>
              </svg>
          </div>
          <p class="text-sm font-bold text-red-800">{{message}}</p>
          <button onclick="document.getElementById('alert-error').remove()" class="ml-auto text-red-400 hover:text-red-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M6 18L18 6M6 6l12 12"></path></svg>
    </button>
      </div>
      {{/if}}
      <form action="/auth/login" method="POST" id="login-form">
        <div class="mb-5">
          <label class="block mb-2 text-xs font-bold text-slate-400 uppercase tracking-widest ml-1">E-mail Admin<span class="text-red-500">*</span></label>
          <input
            type="email"
            name="email"
            fieldname="E-mail"
            rules="required|email"
            class="w-full border border-slate-200 bg-slate-50 rounded-2xl p-4 focus:bg-white focus:ring-4 focus:ring-blue-50 focus:border-blue-600 focus:outline-none transition-all"
            placeholder="admin@techservice.com"
          />
        </div>

        <div class="mb-8">
          <label class="block mb-2 text-xs font-bold text-slate-400 uppercase tracking-widest ml-1">Password<span class="text-red-500">*</span></label>
          <input
            type="password"
            name="password"
            fieldname="Password"
            rules="required|min:6"
            class="w-full border border-slate-200 bg-slate-50 rounded-2xl p-4 focus:bg-white focus:ring-4 focus:ring-blue-50 focus:border-blue-600 focus:outline-none transition-all"
            placeholder="••••••••"
          />
        </div>

        <button
          type="submit"
          class="w-full bg-blue-600 hover:bg-blue-700 text-white p-4 rounded-2xl font-bold shadow-lg shadow-blue-100 transition-all transform hover:-translate-y-0.5 active:scale-95"
        >
          Masuk ke Dashboard
        </button>
      </form>
    </div>
    
    <p class="text-center mt-10 text-slate-400 text-xs">
      &copy; 2026 TechService Workshop System.
    </p>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (window.history.replaceState) {
        const url = new URL(window.location.href);
        url.searchParams.delete('message');
        window.history.replaceState({path: url.href}, '', url.href);
    }
    initLiveValidation('#login-form');
  });
</script>