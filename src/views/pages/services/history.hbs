<div class="space-y-8">

  <div class="rounded-3xl bg-white p-8 shadow-sm">

    <div class="flex flex-col gap-4 md:flex-row md:items-start md:justify-between">

      <div>

        <h1 class="text-3xl font-semibold">Service History & Timeline</h1>

        <p class="text-slate-600 mt-2">Tracking: <span class="font-medium text-sky-600">{{service.tracking_code}}</span></p>

      </div>

      <div class="flex gap-2">

        <a
          href="/services/{{service.id}}/progress"
          class="text-slate-600 hover:text-slate-800"
        >
          Update Progress
        </a>

        <a
          href="/services/{{service.id}}"
          class="text-slate-600 hover:text-slate-800"
        >
          Back to Detail
        </a>

      </div>

    </div>

    <div class="mt-8 grid gap-6 md:grid-cols-3">

      <div class="rounded-2xl bg-slate-50 p-5">

        <p class="text-slate-500 text-sm">Customer</p>

        <p class="mt-2 font-semibold">{{service.customer.name}}</p>

        <p class="text-slate-600 text-sm">{{service.customer.email}}</p>

        <p class="text-slate-600 text-sm">{{service.customer.phone}}</p>

      </div>

      <div class="rounded-2xl bg-slate-50 p-5">

        <p class="text-slate-500 text-sm">Device</p>

        <p class="mt-2 font-semibold">{{service.device_name}}</p>

        <p class="text-slate-600 text-sm">{{service.device_brand}}</p>

        <p class="text-slate-600 text-sm">{{#if service.device_category_other}}{{service.device_category_other}}{{else}}{{service.device_category}}{{/if}}</p>

      </div>

      <div class="rounded-2xl bg-slate-50 p-5">

        <p class="text-slate-500 text-sm">Current Status</p>

        <p class="mt-2 font-semibold capitalize">{{service.status}}</p>

        <p class="text-slate-600 text-sm">Total Updates: {{service.histories.length}}</p>

      </div>

    </div>

  </div>

  <div class="rounded-3xl bg-white p-8 shadow-sm">

    <h2 class="text-2xl font-semibold mb-6">Complete Progress Timeline</h2>

    <div class="space-y-4">

      {{#each histories}}

        <div class="rounded-2xl border-l-4 border-sky-600 bg-slate-50 p-6">

          <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-3 mb-4">

            <div>

              <p class="text-sm text-slate-500">Status Update</p>

              <p class="text-xl font-semibold capitalize mt-1">{{status}}</p>

            </div>

            <div class="text-right">

              <p class="text-sm text-slate-500">{{formatDate createdAt}}</p>

              <p class="text-sm font-medium text-slate-700">Updated by: {{updated_by}}</p>

            </div>

          </div>

          {{#if note}}

            <div class="rounded-lg bg-white p-4 mt-4">

              <p class="text-slate-700">{{note}}</p>

            </div>

          {{/if}}

        </div>

      {{else}}

        <div class="rounded-2xl bg-slate-50 p-6 text-center">

          <p class="text-slate-600">Belum ada history update. Mulai update status untuk mencatat progress.</p>

        </div>

      {{/each}}

    </div>

  </div>

</div>