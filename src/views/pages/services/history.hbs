<div class="max-w-4xl mx-auto">
  <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
    <div>
      <a href="/services/{{service.id}}"
        class="text-slate-400 hover:text-blue-600 text-sm font-bold flex items-center gap-2 mb-2 transition-colors">
        ← Kembali ke Detail
      </a>
      <h2 class="text-2xl font-black text-slate-900 tracking-tight">Riwayat Progress</h2>
      <p class="text-slate-500 text-sm italic">Tracking ID: #{{service.tracking_code}}</p>
    </div>
    <div class="flex flex-col gap-1">
      <p class="text-[10px] text-right font-bold text-slate-400 uppercase tracking-widest leading-none mb-1">
        Status Saat Ini</p>
      <span
        class="px-4 py-1.5 text-center rounded-full text-[11px] font-black uppercase tracking-widest {{service.status_color}} shadow-sm border border-white/20">
        {{service.status_label}}
      </span>
    </div>
  </div>

  <div class="relative">
    <div class="absolute left-4 md:left-1/2 top-0 bottom-0 w-0.5 bg-slate-100 -translate-x-1/2 hidden md:block">
    </div>

    <div class="space-y-12">
      {{#each histories}}
      <div class="relative flex flex-col md:flex-row items-center">
        <div class="absolute left-4 md:left-1/2 w-4 h-4 rounded-full border-4 border-white shadow-sm z-10 -translate-x-1/2 
                    {{#if @first}} bg-blue-600 ring-4 ring-blue-50 {{else}} bg-slate-300 {{/if}}">
        </div>
        <div
          class="w-full md:w-[45%] {{#if (isEven @index)}} md:ml-auto md:pl-8 {{else}} md:mr-auto md:pr-8 md:text-right {{/if}} ml-10 md:ml-0">
          <div
            class="bg-white p-6 rounded-3xl border border-slate-100 drop-shadow-xl shadow-slate-200/40 hover:border-blue-200 transition-all group">
            <div class="flex items-center gap-3 mb-3 {{#unless (isEven @index)}} md:justify-end {{/unless}}">
              <span class="px-3 py-1 rounded-lg text-[9px] font-black uppercase tracking-tighter {{this.status_color}}">
                {{this.status_label}}
              </span>
              <span class="text-[10px] text-slate-400 font-mono">{{formatDate this.created_at}}</span>
            </div>
            <h4 class="text-slate-900 font-bold text-sm mb-2 group-hover:text-blue-600 transition-colors">
              {{ this.note }}
            </h4>

            <div
              class="flex items-center gap-2 {{#unless (isEven @index)}} md:justify-end {{/unless}} mt-4 pt-4 border-t border-slate-50">
              <div class="w-6 h-6 rounded-full bg-slate-100 flex items-center justify-center text-[10px]">
                👤</div>
              <span class="text-[10px] font-bold text-slate-500 uppercase">Oleh:
                {{this.updated_by}}</span>
            </div>
          </div>
        </div>
      </div>
      {{/each}}
    </div>
  </div>

  {{#unless histories}}
  <div class="bg-white rounded-[2rem] p-20 text-center border border-slate-100 shadow-sm mt-10">
    <p class="text-slate-400 font-medium">Belum ada riwayat aktivitas untuk unit ini.</p>
  </div>
  {{/unless}}
</div>