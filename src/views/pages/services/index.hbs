<div class="max-w-6xl mx-auto">
  <div class="flex justify-between items-center mb-8">
    <div>
        <h2 class="text-2xl font-bold text-slate-900">Daftar Servis</h2>
        <p class="text-xs text-slate-400 font-medium">Kelola informasi servis.</p>
      </div>
    <button onclick="openCreateModal()"
      class="bg-blue-600 text-white px-6 py-2.5 rounded-xl font-bold text-sm shadow-lg shadow-blue-100 hover:bg-blue-700 transition-all">
      + Tambah Baru
    </button>
  </div>
  <div class="bg-white p-6 rounded-xl border border-slate-100 drop-shadow-md mb-8">
    <form action="/services" method="GET" class="grid grid-cols-1 lg:grid-cols-3 gap-4">
      <div class="flex flex-col">
        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 ml-1">Cari</label>
        <input type="text" name="q" value="{{query.q}}" placeholder="Kode/Nama/Brand..."
          class="w-full bg-white border border-slate-100 rounded-lg px-4 py-2.5 text-sm focus:bg-white focus:ring-4 focus:ring-blue-50 focus:border-blue-600 outline-none transition-all">
      </div>
      <div class="flex flex-col">
        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 ml-1">
          Kategori
        </label>
        <select name="category"
          class="w-full bg-white border border-slate-100 rounded-lg px-4 py-2.5 text-sm focus:bg-white outline-none">
          <option value="">Semua Kategori</option>
          <option value="laptop" {{#if (eq query.category 'laptop' )}}selected{{/if}}>
            Laptop
          </option>
          <option value="smartphone" {{#if (eq query.category 'smartphone' )}}selected{{/if}}>
            Smartphone
          </option>
          <option value="printer" {{#if (eq query.category 'printer' )}}selected{{/if}}>
            Printer
          </option>
        </select>
      </div>
      <div class="flex flex-col">
        <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2 ml-1">Status</label>
        <select name="status"
          class="w-full bg-white border border-slate-100 rounded-lg px-4 py-2.5 text-sm focus:bg-white outline-none">
          <option value="">Semua Status</option>
          <option value="1" {{#if (eq query.status '1' )}}selected{{/if}}>Baru</option>
          <option value="2" {{#if (eq query.status '2' )}}selected{{/if}}>Proses</option>
          <option value="3" {{#if (eq query.status '3' )}}selected{{/if}}>Siap Ambil</option>
          <option value="4" {{#if (eq query.status '4' )}}selected{{/if}}>Selesai</option>
        </select>
      </div>
      <div class="lg:col-span-3 flex justify-end gap-2">
        <button type="submit" title="Terapkan Filter"
          class="flex-1 bg-blue-700 text-white py-2.5 rounded-xl font-bold text-xs hover:bg-slate-800 transition-all">
          Terapkan
        </button>
        <a href="/services" class="bg-slate-100 text-slate-500 py-2.5 px-3 rounded-xl hover:bg-slate-200 transition-all"
          title="Reset Filter">
          🔄
        </a>
      </div>
    </form>
  </div>
  <div class="bg-white rounded-xl drop-shadow-md shadow-slate-200/50 border border-slate-100 overflow-hidden">
    <div class="hidden lg:block overflow-x-auto">
      <table class="w-full text-left border-collapse">
        <thead>
          <tr class="bg-slate-50/50 border-b border-slate-100">
            <th class="px-8 py-5">
              <a href="/services?{{#if query.q}}q={{query.q}}&{{/if}}sortBy=tracking_code&sortOrder={{#if (eq query.sortOrder 'ASC')}}DESC{{else}}ASC{{/if}}"
                class="flex items-center text-xs uppercase tracking-widest hover:text-blue-600 whitespace-nowrap 
                {{#if (eq query.sortBy 'tracking_code')}}text-slate-900 font-black{{else}}text-slate-400 font-bold{{/if}}">
                Tracking {{#if (eq query.sortBy 'tracking_code')}}{{#if (eq query.sortOrder
                'ASC')}}↑{{else}}↓{{/if}}{{else}}↑↓{{/if}}
              </a>
            </th>
            <th class="px-6 py-5 text-xs font-bold text-slate-400 uppercase tracking-widest">Pelanggan</th>
            <th class="px-6 py-5 text-center">
              <a href="/services?{{#if query.q}}q={{query.q}}&{{/if}}sortBy=status&sortOrder={{#if (eq query.sortOrder 'ASC')}}DESC{{else}}ASC{{/if}}"
                class="flex justify-center items-center text-xs uppercase tracking-widest hover:text-blue-600 whitespace-nowrap
                {{#if (eq query.sortBy 'status')}}text-slate-900 font-black{{else}}text-slate-400 font-bold{{/if}}">
                Status {{#if (eq query.sortBy 'status')}}{{#if (eq query.sortOrder
                'ASC')}}↑{{else}}↓{{/if}}{{else}}↑↓{{/if}}
              </a>
            </th>
            <th class="px-6 py-5">
              <a href="/services?{{#if query.q}}q={{query.q}}&{{/if}}sortBy=createdAt&sortOrder={{#if (eq query.sortOrder 'ASC')}}DESC{{else}}ASC{{/if}}"
                class="flex items-center text-xs uppercase tracking-widest hover:text-blue-600 whitespace-nowrap
                {{#if (eq query.sortBy 'createdAt')}}text-slate-900 font-black{{else}}text-slate-400 font-bold{{/if}}">
                Masuk {{#if (eq query.sortBy 'createdAt')}}{{#if (eq query.sortOrder
                'ASC')}}↑{{else}}↓{{/if}}{{else}}↑↓{{/if}}
              </a>
            </th>
            <th class="px-6 py-5">
              <a href="/services?{{#if query.q}}q={{query.q}}&{{/if}}sortBy=updatedAt&sortOrder={{#if (eq query.sortOrder 'ASC')}}DESC{{else}}ASC{{/if}}"
                class="flex items-center text-xs uppercase tracking-widest hover:text-blue-600 whitespace-nowrap
                {{#if (eq query.sortBy 'updatedAt')}}text-slate-900 font-black{{else}}text-slate-400 font-bold{{/if}}">
                Update {{#if (eq query.sortBy 'updatedAt')}}{{#if (eq query.sortOrder
                'ASC')}}↑{{else}}↓{{/if}}{{else}}↑↓{{/if}}
              </a>
            </th>
            <th class="px-8 py-5 text-xs font-bold text-slate-400 uppercase tracking-widest text-right">Aksi</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each services}}
          <tr class="hover:bg-blue-50/30 transition-colors group">
            <td class="px-8 py-6">
              <span class="font-mono text-xs whitespace-nowrap font-bold text-blue-600 bg-blue-50 px-3 py-1 rounded-lg">
                {{this.tracking_code}}
              </span>
            </td>
            <td class="px-6 py-6">
              <div class="flex items-center gap-3">
                <div class="flex flex-col min-w-0">
                  <p class="font-bold text-slate-900 text-sm truncate leading-tight mb-0.5" title="{{this.customer_name}}">
                    {{this.customer_name}}
                  </p>
                  <div class="flex items-center gap-1.5">
                    <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] font-bold bg-slate-100 text-slate-500 uppercase tracking-wider">
                      {{#if this.device_category_other}}{{this.device_category_other}}{{else}}{{this.device_category}}{{/if}}
                    </span>
                    <span class="text-[11px] text-slate-400 truncate font-medium">
                      {{this.device_name}}
                    </span>
                  </div>
                </div>
              </div>
            </td>
            <td class="px-6 py-6 text-center">
              <span
                class="whitespace-nowrap inline-flex px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-tighter {{this.status_color}}">
                {{this.status_label}}
              </span>
            </td>
            <td class="px-6 py-6 text-[11px] text-slate-500">{{formatDate this.created_at}}</td>
            <td class="px-6 py-6 text-[11px] text-slate-500 font-medium italic">{{formatDate this.updated_at}}</td>
            <td class="px-8 py-6 text-right">
              <div class="flex justify-end gap-2">
                <a href="/services/{{this.id}}"
                  class="p-2 text-slate-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition-all"
                  title="Detail">
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24"
                    stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                  </svg>
                </a>
              </div>
            </td>
          </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
    <div class="lg:hidden divide-y divide-slate-100">
      {{#each services}}
      <div class="p-6 flex flex-col gap-4">
        <div class="flex justify-between items-start">
          <span class="font-mono text-[10px] font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded-md">
            #{{this.tracking_code}}
          </span>
          <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase {{this.status_color}}">
            {{this.status_label}}
          </span>
        </div>
        
        <div class="flex flex-col">
          <h4 class="font-black text-slate-900 text-base">{{this.customer_name}}</h4>
          <div class="flex items-center gap-2 mt-1">
              <span class="text-[10px] bg-slate-100 text-slate-500 px-1.5 py-0.5 rounded font-bold uppercase">{{this.device_category}}</span>
              <span class="text-xs text-slate-400 font-medium italic">{{this.device_name}}</span>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4 border-t border-slate-50">
          <div class="text-[10px] text-slate-400 font-medium">
            <p>Masuk: {{formatDate this.created_at}}</p>
          </div>
          <a href="/services/{{this.id}}" class="flex items-center gap-2 bg-blue-600 text-white px-4 py-2 rounded-xl text-[10px] font-black uppercase tracking-widest shadow-lg shadow-blue-100">
              Detail
              <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </div>
      </div>
      {{/each}}
    </div>
    {{#unless services}}
    <div class="flex flex-col px-8 py-16 items-center">
      <span class="text-4xl mb-4">📂</span>
      <p class="text-slate-400 italic text-sm">Belum ada data servis masuk.</p>
    </div>
    {{/unless}}
  </div>
  <div id="createServiceModal" class="fixed inset-0 z-[10002] hidden">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm transition-opacity"></div>
    <div class="flex items-center justify-center min-h-screen p-4">
      <div
        class="relative bg-white w-full max-w-2xl rounded-xl shadow-2xl overflow-hidden transform transition-all scale-95 opacity-0 duration-300"
        id="createModalContainer">
        <div class="p-8 pb-4 flex justify-between items-center">
          <h3 class="text-xl font-black text-slate-900 tracking-tight">Tambah Servis Baru</h3>
          <button onclick="closeCreateModal()"
            class="text-slate-400 hover:text-red-500 transition-colors text-2xl">&times;</button>
        </div>
        <form id="create-service-form" action="/services/store" method="POST" class="p-8 pt-4">
          <div class="flex flex-col gap-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <h4
                class="col-span-2 text-[10px] font-black text-blue-600 uppercase tracking-widest border-b border-slate-100 pb-2">
                Informasi Pelanggan
              </h4>
              <div class="col-span-2 md:col-span-1">
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1 ml-1">Cari /
                  Tambah Nama<span class="text-red-500">*</span></label>
                <select rules="required" id="customer-select" name="customer_id" placeholder="Cari nama..."
                  autocomplete="off" fieldname="Nama Pelanggan">
                  <option value="">Cari nama atau tambah baru...</option>
                  {{#each customers}}
                  <option value="{{this.id}}" data-phone="{{this.phone}}" data-email="{{this.email}}">{{this.name}}
                  </option>
                  {{/each}}
                </select>
                <input type="hidden" name="customer_name" id="hidden_customer_name">
              </div>

              <div class="col-span-2 md:col-span-1">
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1 ml-1">Email
                  Pelanggan<span class="text-red-500">*</span></label>
                <input type="email" id="customer_email" name="customer_email" rules="required|email" fieldname="Email"
                  placeholder="contoh@mail.com"
                  class="w-full bg-white border border-slate-100 rounded-lg px-4 py-2.5 h-[42px] text-sm focus:ring-4 focus:ring-blue-50 focus:border-blue-600 outline-none transition-all disabled:bg-gray-100 disabled:pointer-events-none disabled:opacity-80">
              </div>

              <div class="col-span-2">
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1 ml-1">No.
                  WhatsApp<span class="text-red-500">*</span></label>
                <input type="text" id="customer_phone" name="customer_phone" rules="required|phone" fieldname="Nomor WA"
                  placeholder="0812..."
                  class="w-full bg-white border border-slate-100 rounded-lg px-4 py-2.5 h-[42px] text-sm focus:ring-4 focus:ring-blue-50 focus:border-blue-600 outline-none transition-all disabled:bg-gray-100 disabled:pointer-events-none disabled:opacity-80">
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
              <h4
                class="md:col-span-2 text-[10px] font-black text-blue-600 uppercase tracking-widest border-b border-slate-100 pb-2">
                Informasi Perangkat<span class="text-red-500">*</span></h4>
              <div class="flex flex-col">
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1 ml-1">Merk &
                  Tipe</label>
                <input type="text" name="device_name" rules="required" fieldname="Nama Perangkat"
                  placeholder="Contoh: Asus ROG Strix"
                  class="w-full bg-white border border-slate-100 rounded-lg px-4 py-2.5 h-[42px] text-sm focus:ring-4 focus:ring-blue-50 focus:border-blue-600 outline-none transition-all">
              </div>
              <div class="flex flex-col">
                <label
                  class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1 ml-1">Kategori<span class="text-red-500">*</span></label>
                <select name="device_category"
                  class="w-full bg-white border border-slate-100 rounded-lg px-4 py-2.5 h-[42px] text-sm outline-none">
                  <option value="laptop">Laptop</option>
                  <option value="smartphone">Smartphone</option>
                  <option value="printer">Printer</option>
                  <option value="lainnya">Lainnya</option>
                </select>
              </div>
              <div class="md:col-span-2">
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1 ml-1">Deskripsi
                  Kerusakan<span class="text-red-500">*</span></label>
                <textarea name="note" rules="required|min:10" fieldname="Deskripsi" rows="3"
                  placeholder="Jelaskan detail kerusakan unit di sini..."
                  class="w-full bg-white border border-slate-100 rounded-lg px-4 py-2.5 text-sm focus:ring-4 focus:ring-blue-50 focus:border-blue-600 outline-none transition-all resize-none"></textarea>
              </div>
              <div class="md:col-span-2">
                <label class="block text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-1 ml-1">Estimasi
                  Biaya (Rp)<span class="text-red-500">*</span></label>
                <div class="flex gap-2 items-center group relative">
                  <span
                    class="top-2.5 absolute z-[1] pl-4 text-slate-400 font-bold text-sm group-focus-within:text-blue-600 transition-colors">Rp</span>
                  <div class="w-full">
                    <input type="number" name="estimated_price" rules="required" fieldname="Estimasi Biaya"
                      placeholder="0"
                      class="w-full pl-10 bg-white border border-slate-100 rounded-lg px-4 py-2.5 h-[42px] text-sm focus:ring-4 focus:ring-blue-50 focus:border-blue-600 outline-none transition-all disabled:bg-gray-100 disabled:pointer-events-none disabled:opacity-80">
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mt-8 flex gap-3">
            <button type="button" onclick="closeCreateModal()"
              class="flex-1 py-3 bg-slate-100 text-slate-500 rounded-lg font-bold text-sm hover:bg-slate-200 transition-all">Batal</button>
            <button type="submit"
              class="flex-1 py-3 bg-blue-600 text-white rounded-lg font-bold text-sm shadow-lg shadow-blue-200 hover:bg-blue-700 transition-all">Simpan
              Servis →</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
  const createModal = document.getElementById('createServiceModal');
  const createContainer = document.getElementById('createModalContainer');

  function openCreateModal() {
    createModal.classList.remove('hidden');
    setTimeout(() => {
      createContainer.classList.remove('scale-95', 'opacity-0');
      createContainer.classList.add('scale-100', 'opacity-100');
    }, 10);
  }

  function closeCreateModal() {
    createContainer.classList.remove('scale-100', 'opacity-100');
    createContainer.classList.add('scale-95', 'opacity-0');
    setTimeout(() => {
      createModal.classList.add('hidden');
    }, 300);
  }

  document.addEventListener('DOMContentLoaded', () => {
    initLiveValidation('#create-service-form');
    const phoneInput = document.getElementById('customer_phone');
    const emailInput = document.getElementById('customer_email');
    const hiddenNameInput = document.getElementById('hidden_customer_name');

    const selectEl = document.getElementById('customer-select');
    if (selectEl) {
      new TomSelect('#customer-select', {
        create: true,
        persist: false,
        onInitialize: function () {
          const self = this;
          const originalSelect = self.input;
          const options = originalSelect.querySelectorAll('option');

          options.forEach(option => {
            const value = option.value;
            const phone = option.getAttribute('data-phone');
            const email = option.getAttribute('data-email');

            if (self.options[value]) {
              if (phone) self.options[value].phone = phone;
              if (email) self.options[value].email = email;
            }
          });
        },
        onChange: function (value) {
          const selected = this.options[value];

          if (selected && (selected.phone || selected.email)) {
            phoneInput.value = selected.phone || '';
            emailInput.value = selected.email || '';
            if (typeof displayError === 'function') {
              displayError(phoneInput, '');
              displayError(emailInput, '');
            } else {
              console.error("Fungsi displayError belum ke-load! Pastikan script validator sudah dipasang.", displayError);
            }

            [phoneInput, emailInput].forEach(el => {
              el.readOnly = true;
              el.classList.add('bg-slate-100', 'cursor-not-allowed', 'text-slate-500');

              if (typeof displayError === 'function') {
                displayError(el, '');
              }
            });

            hiddenNameInput.value = selected.text;
          } else {
            [phoneInput, emailInput].forEach(el => {
              el.value = '';
              el.readOnly = false;
              el.classList.remove('bg-slate-100', 'cursor-not-allowed', 'text-slate-500');
            });
            hiddenNameInput.value = value;
          }

          if (typeof validateInput === 'function') {
            validateInput(this.select);
            validateInput(phoneInput);
            validateInput(emailInput);
          }
        },
        render: {
          option: function (data, escape) {
            const phone = data.phone ? escape(data.phone) : 'Baru';
            const email = data.email ? escape(data.email) : '-';
            return `
            <div class="flex flex-col py-1">
                <span class="font-bold text-slate-900">${escape(data.text)}</span>
                <span class="text-[9px] text-slate-400 mt-0.5 tracking-wider uppercase">${phone} • ${email}</span>
            </div>`;
          }
        }
      });
    }
    window.onclick = function (event) {
      if (event.target == createModal) {
        closeCreateModal();
      }
    }
  });
</script>

<style scoped>
  .ts-wrapper.tomselected.w-full {
    padding: 0 !important;
    border: none !important;
  }

  .ts-control {
    background-color: white !important;
    border: 1px solid #f1f5f9 !important; /* border-slate-100 */
    border-radius: 0.5rem !important;
    padding: 10px 16px !important;
    font-size: 0.875rem !important;
    color: #0f172a !important;
    box-shadow: none !important;
    height: 42px !important;
    transition: all 0.2s;
  }
  
  .ts-wrapper.focus .ts-control {
    background-color: #ffffff !important;
    border-color: #2563eb !important;
    box-shadow: 0 0 0 4px #eff6ff !important;
  }
  
  .ts-dropdown {
    border-radius: 0.75rem !important;
    border: 1px solid #f1f5f9 !important;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
    margin-top: 5px !important;
    padding: 0.5rem !important;
  }

  .ts-dropdown .option {
    padding: 0.5rem 0.75rem !important;
    border-radius: 0.5rem !important;
    cursor: pointer;
  }

  .ts-dropdown .active {
    background-color: #eff6ff !important;
    color: #2563eb !important;
  }
</style>